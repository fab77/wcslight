{
    "name": "wcslight",
    "description": "Lightweight JavaScript/TypeScript library for astronomical World Coordinate System (WCS), FITS, HiPS and HEALPix projections.",
    "version": "3.1.2",
    "keywords": [
        "wcs",
        "world-coordinate-system",
        "astronomy",
        "astrophysics",
        "fits",
        "hips",
        "healpix",
        "coordinates",
        "projection",
        "browser"
    ],
    "author": "Fabrizio Giordano (fab77)",
    "license": "SEE LICENSE IN LICENSE.md",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "homepage": "https://github.com/fab77/wcslight#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/fab77/wcslight.git"
    },
    "bugs": {
        "url": "https://github.com/fab77/wcslight/issues",
        "email": "fabriziogiordano77@gmail.com"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./lib-esm/index.d.ts",
            "import": "./dist/wcslight.esm.js",
            "require": "./dist/wcslight.cjs"
        },
        "./package.json": "./package.json"
    },
    "module": "./dist/wcslight.esm.js",
    "main": "./dist/wcslight.cjs",
    "types": "./lib-esm/index.d.ts",
    "files": [
        "lib-esm/",
        "dist/",
        "README.md",
        "LICENSE.md",
        "LICENSE-COMMERCIAL.md",
        "LICENSE-AGPL.md",
        "package.json"
    ],
    "scripts": {
        "clean": "shx rm -rf dist lib-esm",
        "build": "npm run clean && tsc && webpack --mode=production",
        "dev": "npm run clean && tsc && webpack --mode=development --watch --progress",
        "prod": "npm run build",
        "test": "npm run test:ci",
        "test:unit": "node --test test/unit/*.test.mjs",
        "test:integration": "node --test test/integration/*.test.mjs",
        "test:remote": "node --test test/remote/*.test.mjs",
        "test:ci": "npm run build && npm run test:unit && npm run test:integration",
        "test:all": "npm run test:ci && npm run test:remote",
        "webtest": "cp dist/* webtest/; node server.cjs"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "shx": "^0.3.4",
        "terser-webpack-plugin": "^5.6.1",
        "ts-loader": "^9.0.0",
        "typescript": "^5.0.0",
        "webpack": "^5.0.0",
        "webpack-cli": "^5.0.0"
    },
    "dependencies": {
        "astrospatial-core": "^0.4.1",
        "jsfitsio": "^3.0.0"
    },
    "browser": {
        "fs": false,
        "node:fs/promises": false,
        "node:fs": false,
        "fs/promises": false,
        "process": false
    }
}
