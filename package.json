{
    "name": "wcslight",
    "description": "WCS Javascript library.",
    "version": "3.1.0-snapshot",
    "keywords": [
        "WCS",
        "WCS light",
        "lightweight WCS for browser"
    ],
    "author": "Fabrizio Giordano (fab77)",
    "license": "SEE LICENSE IN LICENSE.md",
    "homepage": "https://github.com/fab77/wcslight#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/fab77/wcslight.git"
    },
    "bugs": {
        "url": "https://github.com/fab77/wcslight/issues",
        "email": "fabriziogiordano77@gmail.com"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./lib-esm/index.d.ts",
            "import": "./dist/wcslight.esm.js",
            "require": "./dist/wcslight.cjs"
        },
        "./package.json": "./package.json"
    },
    "module": "./dist/wcslight.esm.js",
    "main": "./dist/wcslight.cjs",
    "types": "./lib-esm/index.d.ts",
    "files": [
        "lib-esm/",
        "dist/",
        "README.md",
        "LICENSE.md",
        "LICENSE-COMMERCIAL.md",
        "LICENSE-NONCOMMERCIAL.md",
        "package.json"
    ],
    "scripts": {
        "clean": "shx rm -rf dist lib-esm",
        "build": "npm run clean && tsc && webpack --mode=production",
        "dev": "npm run clean && tsc && webpack --mode=development --watch --progress",
        "prod": "npm run build",
        "test": "npm run test:unit",
        "test:unit": "npm run build && node --test test/unit/*.test.mjs",
        "test:integration": "npm run build && node --test test/integration/*.test.mjs",
        "test:all": "npm run test:unit && npm run test:integration",
        "webtest": "cp dist/* webtest/; node server.cjs"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "shx": "^0.3.4",
        "ts-loader": "^9.0.0",
        "typescript": "^5.0.0",
        "webpack": "^5.0.0",
        "webpack-cli": "^5.0.0"
    },
    "dependencies": {
        "@fab77/astrospatial-core": "^0.3.0",
        "jsfitsio": "^2.1.0"
    },
    "browser": {
        "fs": false,
        "node:fs/promises": false,
        "node:fs": false,
        "fs/promises": false,
        "process": false
    }
}